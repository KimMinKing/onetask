# Docker Compose environment example
# Copy this file to .env and replace every placeholder before deployment.

# Docker's Next.js server forwards /api and /images to this internal address.
NEXT_PUBLIC_API_URL=http://backend:8000
APP_BASE_URL=https://onetask.example.com
ENABLE_SCHEDULER=true
COOKIE_SECURE=true

# PostgreSQL
POSTGRES_USER=tradediary
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=onetask

# Generate SECRET_KEY and BOOTSTRAP_TOKEN independently with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
BOOTSTRAP_TOKEN=replace-with-a-second-long-random-secret
